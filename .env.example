# Copy this file to .env and fill in your own key. .env is gitignored and never committed.

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-AU

# Optional. Only needed if you set LLM_ENABLED=true for the semantic check adjudicator.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_ENABLED=false
