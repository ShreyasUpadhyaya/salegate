.env
# Ignore data/ contents, but not the directory itself, so the negations below can work.
data/*
# The recording script is hand-authored source, not generated data.
!data/scripts/
data/scripts/*
!data/scripts/*.md
cache/
handout/
*.wav
*.mp3
*.m4a
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
# Personal build log of phase prompts and replies. Notes to self, not source.
prompts
